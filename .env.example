# =============================================================================
# Outbound healthcare voice agent — configuration
#
# Copy to .env and fill in. Anything left as template text (xxxx, your-...) is
# detected and treated as unset, so a half-filled file fails with a clear
# message instead of a confusing 401 from a provider.
#
# Only sections 1 to 3 are required. Everything below that is optional and has
# a working default.
# =============================================================================


# =============================================================================
# 1. LIVEKIT  (required)
#    The voice infrastructure. Carries the audio, runs the agent worker, and
#    places the outbound SIP call.
#    Get these at https://cloud.livekit.io -> your project -> Settings -> Keys
# =============================================================================
LIVEKIT_URL=wss://your-project-xxxxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret


# =============================================================================
# 2. OPIK  (required)
#    Tracing and online evaluation. Every call becomes one trace with its
#    transcript, tool calls, recording, analysis and evaluation scores.
#    Get these at https://www.comet.com/signup -> Opik -> Account settings
#    OPIK_WORKSPACE is your Comet username unless you made a team workspace.
# =============================================================================
OPIK_API_KEY=your-opik-api-key
OPIK_WORKSPACE=your-comet-username
OPIK_PROJECT_NAME=healthcare-voice-agent
# Self-hosted Opik only. Leave commented out for Opik Cloud.
# OPIK_URL_OVERRIDE=http://localhost:5173/api


# =============================================================================
# 3. MODEL PROVIDERS  (at least one required)
#
#    Three stages need a provider: speech-to-text, the language model, and
#    text-to-speech. Each resolves independently from whatever keys are present,
#    so you can mix providers. See section 6 to force a specific choice.
#
#    OPENAI    drives the conversation. gpt-4o-mini is the default because it
#              answers immediately; reasoning models think before replying,
#              which on a phone call is heard as dead air.
#    ELEVEN    speech in and out. Best voice quality, and its transcriber
#              accepts vocabulary hints so clinical words survive.
#    GROQ      an alternative language model. Very fast, generous free tier.
# =============================================================================
OPENAI_API_KEY=sk-proj-...

# ElevenLabs. https://elevenlabs.io -> profile menu -> API Keys
# A FREE plan can only synthesize "premade" voices through the API; shared
# library voices return 402. List what yours can use:
#   curl -H "xi-api-key: $ELEVEN_API_KEY" https://api.elevenlabs.io/v2/voices
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# Groq. https://console.groq.com/keys  Free, no card.
GROQ_API_KEY=

# Deepgram. https://console.deepgram.com  Transcription only, and it takes
# priority over ElevenLabs for that stage: transcription is the latency-critical
# part of a call and Deepgram is built for it. Measured on a real call,
# ElevenLabs cost 2.7s per turn to transcribe; speech synthesis cost 0.28s.
DEEPGRAM_API_KEY=

# CARTESIA_API_KEY=


# =============================================================================
# 4. TELEPHONY  (required only to dial a real phone)
#
#    Without this the agent still runs; use --simulate and talk to it from a
#    browser. With it, dispatch_call.py rings an actual telephone.
#
#    SIP_OUTBOUND_TRUNK_ID is a LiveKit id (starts with ST_). It points LiveKit
#    at a SIP trunk you own at a telephony carrier. LiveKit does not sell phone
#    numbers, so the number and the trunk come from Twilio, Telnyx or similar.
#
#    Easiest path, from a Twilio account with a voice-capable number:
#        python setup_telephony.py --check
#        python setup_telephony.py --number +1XXXXXXXXXX --apply
#    That creates the trunk, generates its credentials, attaches the number,
#    registers it with LiveKit, and prints the id to paste below.
#
#    Twilio trial accounts can only call numbers verified in the console, and
#    allow exactly one SIP trunk.
# =============================================================================
SIP_OUTBOUND_TRUNK_ID=

# Only used by setup_telephony.py, never at call time. Prefer an API Key over
# the main auth token, and revoke it when you are done:
# https://console.twilio.com/us1/account/keys-credentials/api-keys
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=


# =============================================================================
# 5. VOICE MODE
#
#    pipeline  separate speech-to-text, language model and text-to-speech.
#              Every turn pays three sequential network hops, but you choose
#              each component and can use any ElevenLabs voice. This is the
#              default and the configuration that is demonstrated.
#
#    realtime  OpenAI speech-to-speech. One model hears and speaks, so a turn
#              costs one hop instead of three. Lower latency, but the voice is
#              OpenAI's and the separate components no longer apply.
# =============================================================================
VOICE_MODE=pipeline
# REALTIME_MODEL=gpt-realtime-mini
# REALTIME_VOICE=marin


# =============================================================================
# 6. PROVIDER AND MODEL OVERRIDES  (all optional, defaults shown)
#
#    Each stage picks a provider from the keys above. Set these to force one.
#    Providers: openai | groq | elevenlabs | deepgram | cartesia | livekit
#    "livekit" means LiveKit Inference, hosted speech billed through your
#    LiveKit account, which needs no extra key.
# =============================================================================
# LLM_PROVIDER=openai
# STT_PROVIDER=elevenlabs
# TTS_PROVIDER=elevenlabs

# LLM_MODEL=gpt-4o-mini
# ANALYSIS_MODEL=gpt-4o-mini          # post-call analysis, needs strict JSON
# OPIK_JUDGE_MODEL=gpt-4o-mini        # the LLM-as-judge evaluators
# OPIK_JUDGE_BACKEND=portable         # portable | geval (geval needs logprobs)

# ElevenLabs detail
# ELEVEN_TTS_MODEL=eleven_turbo_v2_5  # streams; eleven_v3_conversational does not
# ELEVEN_STT_MODEL=scribe_v2_realtime # streaming; scribe_v1 on a free plan
# ELEVEN_STT_LANGUAGE=en
# ELEVEN_STT_SECONDARY_LANGUAGES=hi   # patients answer in their own language
# ELEVEN_SPEED=0.85                   # 0.7 slowest .. 1.2 fastest
# ELEVEN_STABILITY=0.6
# ELEVEN_SIMILARITY=0.75

# LiveKit Inference, used when no dedicated speech key is set
# LIVEKIT_STT_MODEL=deepgram/nova-3-medical
# LIVEKIT_TTS_MODEL=cartesia/sonic-2
# LIVEKIT_LLM_MODEL=openai/gpt-4o-mini

# Turn taking. Leave these unset. The SDK defaults are known to work; an
# earlier override broke turn completion entirely and the agent went silent
# after the patient replied. Set them only if you are deliberately testing.
# ENDPOINTING_MIN_DELAY=
# ENDPOINTING_MAX_DELAY=

# Groq only. gpt-oss models reason before answering, which is heard as a pause.
# GROQ_REASONING_EFFORT=low


# =============================================================================
# 7. OPERATIONAL  (all optional)
# =============================================================================
# AGENT_NAME=healthcare-outbound-agent   # must match worker and dispatcher
# LIVEKIT_CLOUD_RECORDING=true           # also upload sessions to LiveKit Cloud
# SHUTDOWN_TIMEOUT_S=180                 # budget for the post-call pipeline
